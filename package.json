{
  "name": "agent-qa-kit",
  "version": "0.3.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "agent-qa-kit": "bin/agent-qa-kit.mjs"
  },
  "files": [
    "bin/",
    ".claude/agents/",
    ".claude/hooks/",
    ".claude/qa-settings.json",
    ".claude/repair-settings.json",
    "qa/*.sh",
    "qa/*.ts",
    ".github/workflows/qa-write-tests.yml",
    ".github/workflows/qa-verify.yml",
    ".github/workflows/qa-branches.yml",
    ".github/workflows/qa-amend-tests.yml",
    ".github/workflows/qa-approval.yml"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test qa/tests/*.test.ts eval/tests/*.test.ts",
    "check": "npm run typecheck && npm test && bash qa/test-guard.sh && bash qa/test-verdict-check.sh && bash qa/test-check-scope.sh && node qa/check-tests.ts"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0"
  }
}
