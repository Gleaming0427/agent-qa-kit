{
  "permissions": {
    "allow": [
      "Read(**)",
      "Grep(**)",
      "Edit(**/*.test.ts)",
      "Edit(**/*.test.tsx)",
      "Edit(e2e/*.spec.ts)",
      "Bash(npm run test:affected)",
      "Bash(npm run test:e2e -- --grep *)",
      "Bash(npm run test:summary)",
      "Bash(npm run test:summary -- --run *)",
      "Bash(npx vitest run *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/.npmrc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "WebFetch",
      "WebSearch",
      "Bash(git push *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${QA_KIT_DIR:-$CLAUDE_PROJECT_DIR}\"/.claude/hooks/qa-guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${QA_KIT_DIR:-$CLAUDE_PROJECT_DIR}\"/.claude/hooks/verdict-check.ts"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "network": {
      "allowedDomains": []
    }
  }
}
